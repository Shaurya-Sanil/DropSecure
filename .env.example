# DropSecure Environment Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Provider Mode: "local" (in-memory + local storage + dev outbox) or "aws" (uses AWS SDK v3 with AWS / LocalStack)
PROVIDER_MODE=local

# Database Configuration
DATABASE_URL=postgresql://dropsecure_user:dropsecure_password@localhost:5432/dropsecure_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dropsecure_db
DB_USER=dropsecure_user
DB_PASSWORD=dropsecure_password

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-for-dropsecure-development-only-32chars
JWT_EXPIRES_IN=7d

# AWS Configuration (LocalStack or Real AWS)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# If using LocalStack: http://localhost:4566, leave empty for real AWS
AWS_ENDPOINT_URL=http://localhost:4566

# S3 Storage Configuration
S3_BUCKET_NAME=dropsecure-parcel-photos
S3_PRESIGNED_URL_EXPIRES=900

# SQS Queue Configuration
SQS_QUEUE_URL=http://localhost:4566/000000000000/notification-queue
SQS_DLQ_URL=http://localhost:4566/000000000000/notification-dlq

# SNS Notification Configuration
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:000000000000:parcel-notifications

# SSM Parameter Store
SSM_PARAM_DB_SECRET=/dropsecure/db/password
SSM_PARAM_JWT_SECRET=/dropsecure/jwt/secret
